{
  "pollIntervalSeconds": 1200,
  "workCheckIntervalSeconds": 300,
  "port": 4747,
  "oauthCallbackPort": 4748,
  "repoRoots": ["~/code"],
  "repoPaths": [],
  "onboarded": true,
  "githubUser": "",
  "linearUserId": "",
  "pickupStates": [
    "Ready for Development"
  ],
  "processExistingOnFirstRun": true,
  "moveToInProgressOnApprove": false,
  "lowConfidenceThreshold": 0.6,
  "llm": {
    "provider": "cli",
    "model": "claude-opus-5-5",
    "claudeBin": "claude"
  },
  "launch": {
    "supacodeBin": "/Applications/supacode.app/Contents/Resources/bin/supacode",
    "claudeBin": "claude",
    "fetch": true,
    "base": "",
    "background": false
  },
  "repos": {
    "api": {
      "description": "Backend service: REST API, auth, database models and background jobs."
    },
    "web": {
      "description": "Frontend app (React): pages, routing, dashboards and shared UI components."
    },
    "infra": {
      "exclude": true
    }
  }
}
